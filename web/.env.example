# Exemplo de variáveis para Netlify/ambiente local. NUNCA publique chaves reais aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
JVG_SUPABASE_SECRET_KEY=

# Somente servidor; Token Master Focus para consultas acessorias, como CNPJ.
# Nao reutilize aqui o token de emissao de homologacao.
JVG_FOCUS_MASTER_TOKEN=
# Somente servidor; token do emitente piloto na Focus (ambiente de homologacao).
JVG_FOCUS_HOMOLOGACAO_TOKEN=
# UUID da empresa piloto autorizada a usar o token acima. Nao usar para outros clientes.
JVG_FOCUS_PILOT_COMPANY_ID=
